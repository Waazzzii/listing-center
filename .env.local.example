# =========================================================
# UI PREVIEW MODE — booting `npm run dev` without a DB
# Set LC_MOCK_DATA=true (or leave Supabase vars unset and
# mock mode auto-enables) to serve the UI with realistic
# synthetic data for design preview.
# =========================================================
LC_MOCK_DATA=true

# Supabase (required for real data; overrides mock mode when set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Streamline PMS API
STREAMLINE_API_URL=https://web.streamlinevrs.com/api/json
STREAMLINE_TOKEN_KEY=your-token-key
STREAMLINE_TOKEN_SECRET=your-token-secret

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SIGNING_SECRET=your-signing-secret

# WheelHouse (Phase 2)
WHEELHOUSE_API_KEY=your-api-key
WHEELHOUSE_API_URL=https://api.usewheelhouse.com

# Airbnb session encryption
AIRBNB_SESSION_ENCRYPTION_KEY=your-32-byte-hex-key
